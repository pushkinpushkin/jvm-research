# Local, short full-runtime pass for visualization work.
#
# Purpose: verify all four runtime profiles can produce comparable artifacts on a
# developer machine and generate an initial HTML report. This is not a baseline,
# not a pilot, and not evidence for runtime comparison.

MATRIX_LABEL=local-idle-rare-quick
MATRIX_PASSES=forward

FRESH_IDLE_DURATION=90s
RARE_REQUESTS_DURATION=2m
RARE_POST_IDLE_SECONDS=60
RARE_RATE=1
RARE_RATE_TIME_UNIT=10s

MATRIX_ORDER_POOL=1000
MATRIX_SEED_ORDERS=1000

INTERVAL_SECONDS=5
COLLECT_PROMETHEUS=true
K6_TIME_SERIES=true

REPORT_HTML=results/local-idle-rare-quick/report.html
