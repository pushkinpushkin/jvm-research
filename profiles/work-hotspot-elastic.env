# New 2 CPU experiment; historical baseline remains unchanged.
MEMORY_PROFILE=elastic-heap
RUNTIME_MODE=jit
RUNTIME_DOCKERFILE=Dockerfile
# Work-like HotSpot baseline profile.
# Uses public BellSoft Liberica image.

RUN_PROFILE=work-hotspot-elastic
JVM_VARIANT=hotspot-liberica
JVM_PROFILE=memory-elastic
RUNTIME_IMAGE=bellsoft/liberica-openjre-alpine:21.0.11-11

APP_PORT=8080
TZ=Europe/Moscow
SPRING_PROFILES_ACTIVE=production,kubernetes

CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=1g

WORK_CPU_REQUEST=10m
WORK_CPU_LIMIT=2
WORK_MEMORY_REQUEST=512Mi
WORK_MEMORY_LIMIT=1Gi
WORK_TIMEZONE=Europe/Moscow
WORK_EXTRA_JAVA_OPTS=-Dserver.max-http-request-header-size=30000

JAVA_TOOL_OPTIONS="-Xms32m -Xmx512m -Duser.timezone=Europe/Moscow -Dserver.max-http-request-header-size=30000 -XX:+PrintCommandLineFlags -Xlog:gc*,safepoint:file=/app/logs/gc.log:time,uptime,level,tags"
