# New 2 CPU experiment; historical baseline remains unchanged.
MEMORY_PROFILE=fixed-heap
RUNTIME_MODE=jit
RUNTIME_DOCKERFILE=Dockerfile
# Work-like JVM baseline profile for the OpenJ9 image.
# Uses OpenJ9-specific verbose GC logging.

RUN_PROFILE=work-openj9-fixed
JVM_VARIANT=openj9
JVM_PROFILE=memory-fixed
RUNTIME_IMAGE=ibm-semeru-runtimes:open-21.0.11.0-jdk-jammy

APP_PORT=8080
TZ=Europe/Moscow
SPRING_PROFILES_ACTIVE=production,kubernetes

CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=1g

WORK_CPU_REQUEST=10m
WORK_CPU_LIMIT=2
WORK_MEMORY_REQUEST=512Mi
WORK_MEMORY_LIMIT=1Gi
WORK_TIMEZONE=Europe/Moscow
WORK_EXTRA_JAVA_OPTS=-Dserver.max-http-request-header-size=30000

JAVA_TOOL_OPTIONS='-Xms512m -Xmx512m -Duser.timezone=Europe/Moscow -Dserver.max-http-request-header-size=30000 -verbose:gc -Xverbosegclog:/app/logs/gc.log'
