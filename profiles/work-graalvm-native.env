# Native heap ergonomics: container limit is controlled; no JVM flags.
RUN_PROFILE=work-graalvm-native
JVM_VARIANT=graalvm-native
JVM_PROFILE=native-default
RUNTIME_MODE=native
MEMORY_PROFILE=native-default
RUNTIME_DOCKERFILE=Dockerfile.native
NATIVE_BUILDER_IMAGE=container-registry.oracle.com/graalvm/native-image:21-ol9
RUNTIME_IMAGE=oraclelinux:9-slim
APP_PORT=8080
TZ=Europe/Moscow
SPRING_PROFILES_ACTIVE=production,kubernetes
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=1g
WORK_CPU_REQUEST=10m
WORK_CPU_LIMIT=2
WORK_MEMORY_REQUEST=512Mi
WORK_MEMORY_LIMIT=1Gi
WORK_TIMEZONE=Europe/Moscow
